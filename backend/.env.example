# OfferGPT Backend Configuration Example
DATABASE_URL=sqlite+aiosqlite:///./offergpt.db
REDIS_URL=redis://localhost:6379/1
REDIS_ENABLED=false
OPENAI_API_KEY=sk-your-openai-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
ASR_PROVIDER=whisper
ASR_MODEL=base
TTS_PROVIDER=edgeTts
# ---- 语音引擎：local（本地管线）/ volcengine（火山引擎豆包端到端实时语音）----
VOICE_ENGINE_DEFAULT=local
VOLCENGINE_SPEECH_ENABLED=true
# 新版豆包语音控制台创建 API Key（请求头 X-Api-Key），与 TOS 的 AK/SK 不是同一套凭证
VOLCENGINE_SPEECH_API_KEY=
# 可选 App ID（请求头 X-Api-App-Id）
VOLCENGINE_SPEECH_APP_ID=
# 全双工版本 WebSocket 地址
VOLCENGINE_SPEECH_WS_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# 可选 Resource ID（请求头 X-Api-Resource-Id），一般留空
VOLCENGINE_SPEECH_RESOURCE_ID=
# 全双工版本模型固定 1.2.6.1
VOLCENGINE_SPEECH_MODEL=1.2.6.1
# 音色名（控制台「音色列表」），英文练习请填英文音色
VOLCENGINE_SPEECH_VOICE=zh_female_vv_jupiter_bigtts
# 语速 [-50, 100]，0 为默认
VOLCENGINE_SPEECH_SPEED=0
# 默认 false：使用浏览器 speechSynthesis 朗读，响应更快
ENABLE_SERVER_TTS=false
# VAD：短句 0.5s 静音结束；长发言自动放宽句中停顿
VAD_SILENCE_MS=500
VAD_LONG_UTTERANCE_SILENCE_MS=1200
VAD_LONG_UTTERANCE_THRESHOLD_MS=2500
VAD_TURN_CONFIRM_MS=80
VAD_MIN_TURN_SECONDS=0.4
VAD_MAX_TURN_SECONDS=20
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
ENV=development
LOG_LEVEL=info

# 对象存储（火山引擎 TOS）；未配置时使用本地 ./storage/sessions/ 兜底
OBJECT_STORAGE_PROVIDER=local
# OBJECT_STORAGE_PROVIDER=tos
# TOS_ENDPOINT=tos-cn-guangzhou.volces.com
# TOS_REGION=cn-guangzhou
# TOS_BUCKET=your-bucket
# TOS_ACCESS_KEY_ID=your-access-key
# TOS_SECRET_ACCESS_KEY=your-secret-key
LOCAL_STORAGE_DIR=./storage
